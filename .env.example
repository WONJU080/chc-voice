# 开发环境回退，不是默认存储方式。
# 正式使用请通过 UI 或 `chc-voice key set` 把 key 写入 macOS Keychain。
# 不要提交真实的 .env。

DASHSCOPE_API_KEY=
FISH_AUDIO_API_KEY=
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://api.deepseek.com/v1
CHAT_LLM_MODEL=deepseek-chat
FISH_AUDIO_MODEL=drama-3
BAILIAN_STT_MODEL=qwen-audio-3.1-asr-flash-streaming

# 可选：Fish Audio 在部分网络需要代理
# CHC_VOICE_PROXY=http://127.0.0.1:7892
